load("//tools/lint:lint.bzl", "add_lint_tests")
load(
    "//tools/skylark:drake_cc.bzl",
    "drake_cc_binary",
    "drake_cc_googletest",
    "drake_cc_library",
)

package(default_visibility = ["//visibility:private"])

exports_files(["run_ladder.py"])

drake_cc_library(
    name = "settling_lib",
    srcs = ["settling.cc"],
    hdrs = ["settling.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//common:essential",
        "//geometry:proximity_properties",
        "//geometry:shape_specification",
        "//geometry/query_results:contact_surface",
        "//geometry/render:render_camera",
        "//geometry/render_vtk",
        "//math:geometric_transform",
        "//multibody/contact_solvers/sap:sap_solver_statistics",
        "//multibody/math:spatial_algebra",
        "//multibody/plant",
        "//multibody/plant:contact_results",
        "//multibody/plant:coulomb_friction",
        "//multibody/tree:spatial_inertia",
        "//systems/analysis:simulator",
        "//systems/framework:context",
        "//systems/framework:diagram_builder",
        "//systems/framework:event_collection",
        "//systems/sensors:image_writer",
        "//systems/sensors:rgbd_sensor",
        "//tools/voxel_sdf_experiments/common:components",
        "//tools/voxel_sdf_experiments/common:emit",
        "//tools/voxel_sdf_experiments/common:mesh_export",
        "//tools/voxel_sdf_experiments/common:reference",
        "//tools/voxel_sdf_experiments/common:representation",
        "//tools/voxel_sdf_experiments/common:surface_view",
        "@fmt",
    ],
)

drake_cc_binary(
    name = "settling",
    srcs = ["settling_main.cc"],
    deps = [
        ":settling_lib",
        "//tools/voxel_sdf_experiments/common:representation",
        "@gflags",
    ],
)

drake_cc_googletest(
    name = "settling_test",
    srcs = ["test/settling_test.cc"],
    deps = [":settling_lib"],
)

add_lint_tests()
