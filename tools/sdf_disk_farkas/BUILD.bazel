load("//tools/lint:lint.bzl", "add_lint_tests")
load("//tools/skylark:drake_cc.bzl", "drake_cc_binary")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "report_tools",
    srcs = [
        "README.md",
        "generate_report.py",
        "run_comparison.py",
        "view_surface.py",
    ],
)

_DISK_REFERENCE_DEPS = [
    "//common:name_value",
    "//common/yaml:yaml_io",
    "//geometry:geometry_ids",
    "//geometry:proximity_properties",
    "//geometry:shape_specification",
    "//geometry/query_results:contact_surface",
    "//math:geometric_transform",
    "//multibody/contact_solvers:tamsi_solver_statistics",
    "//multibody/contact_solvers/sap:sap_solver_statistics",
    "//multibody/plant",
    "//multibody/tree",
    "//systems/analysis:simulator",
    "//systems/framework:diagram",
    "//systems/framework:diagram_builder",
    "//systems/framework:event_collection",
]

drake_cc_binary(
    name = "disk_contact_reference",
    srcs = ["disk_contact_reference.cc"],
    data = ["disk_plane.yaml"],
    deps = _DISK_REFERENCE_DEPS,
)

# Experimental variant: the disk hangs on a four-DOF {x, y, yaw, z} mount
# (PlanarJoint + PrismaticJoint) so the normal load settles to N = mg
# dynamically, instead of the plain PlanarJoint's pre-bisected fixed height.
drake_cc_binary(
    name = "disk_contact_reference_zfree",
    srcs = ["disk_contact_reference_zfree.cc"],
    data = ["disk_plane.yaml"],
    deps = _DISK_REFERENCE_DEPS,
)

# Experimental variant: the disk is a fully free 6-DOF body (no joint). It
# settles under gravity + contact for --settle-time, then receives the slide
# + spin as a velocity kick. Roll/pitch are unconstrained, testing whether the
# contact moment keeps the disk flat.
drake_cc_binary(
    name = "disk_contact_reference_free",
    srcs = ["disk_contact_reference_free.cc"],
    data = ["disk_plane.yaml"],
    deps = _DISK_REFERENCE_DEPS,
)

add_lint_tests()
